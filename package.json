{
  "name": "nexus-iq",
  "version": "2.11.2",
  "description": "Local-first qualitative text measurement platform.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run server\"",
    "next:dev": "next dev -H 127.0.0.1",
    "next:build": "next build",
    "next:start": "next start -H 127.0.0.1",
    "server": "node server/index.js",
    "build": "npm run next:build",
    "start": "concurrently \"npm run next:start\" \"npm run server\"",
    "start:docker": "concurrently \"next start -H 0.0.0.0\" \"npm run server\"",
    "test": "node --test tests/unit/*.test.js tests/server/*.test.js tests/e2e/*.test.js tests/integration/*.test.js tests/sim/*.test.js",
    "test:a11y": "playwright test -c playwright.config.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-version-coherence.mjs",
    "docker:smoke": "node scripts/docker-smoke.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "concurrently": "^8.2.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "file:./vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "brace-expansion": "~5.0.9",
    "nanoid": "^3.3.18",
    "next": {
      "postcss": "^8.5.18",
      "sharp": "0.35.4"
    },
    "sharp": "0.35.4",
    "@xmldom/xmldom@<=0.8.14": "0.8.15"
  },
  "author": "Sidakpreet Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/nexus-iq.git"
  },
  "bugs": {
    "url": "https://github.com/impreetentious/nexus-iq/issues"
  },
  "homepage": "https://github.com/impreetentious/nexus-iq"
}
