{
  "name": "nexus-iq",
  "version": "2.8.0",
  "description": "Local-first qualitative text measurement platform.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run server\"",
    "next:dev": "next dev -H 127.0.0.1",
    "next:build": "next build",
    "next:start": "next start -H 127.0.0.1",
    "server": "node server/index.js",
    "build": "npm run next:build",
    "start": "concurrently \"npm run next:start\" \"npm run server\"",
    "start:docker": "concurrently \"next start -H 0.0.0.0\" \"npm run server\"",
    "test": "node --test tests/unit/*.test.js tests/server/*.test.js tests/e2e/*.test.js tests/integration/*.test.js tests/sim/*.test.js",
    "test:a11y": "playwright test -c playwright.config.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-version-coherence.mjs",
    "docker:smoke": "node scripts/docker-smoke.mjs"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "concurrently": "^8.0.1",
    "fflate": "^0.8.2",
    "mammoth": "^1.8.0",
    "next": "^16.1.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "file:./vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "eslint": "^10.0.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1"
  },
  "overrides": {
    "brace-expansion": "~5.0.4",
    "next": {
      "postcss": "^8.5.8",
      "sharp": "^0.34.5"
    }
  },
  "author": "Sidakpreet Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/nexus-iq.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/nexus-iq/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/nexus-iq#"
}
